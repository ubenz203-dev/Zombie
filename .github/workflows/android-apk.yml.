
name: Dead Horizon Android APK

on:
  workflow_dispatch:
  push:
    paths:
      - "*.zip"
      - ".github/workflows/android-apk.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Download repository
        uses: actions/checkout@v4

      - name: Extract Dead Horizon ZIP
        run: |
          ZIP_FILE=$(find . -maxdepth 1 -type f -iname "*.zip" | head -n 1)
          if [ -z "$ZIP_FILE" ]; then
            echo "ZIP project tidak ditemukan"
            exit 1
          fi
          mkdir -p src
          unzip -q "$ZIP_FILE" -d src
          test -f src/project.godot

      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Install Android SDK
        uses: android-actions/setup-android@v3
        with:
          packages: "platform-tools build-tools;34.0.0 platforms;android-34 cmake;3.10.2.4988404 ndk;23.2.8568313"

      - name: Install Godot 4.3
        run: |
          BASE="https://github.com/godotengine/godot/releases/download/4.3-stable"
          curl -fsSL -o godot.zip "$BASE/Godot_v4.3-stable_linux.x86_64.zip"
          curl -fsSL -o templates.tpz "$BASE/Godot_v4.3-stable_export_templates.tpz"
          unzip -q godot.zip
          sudo mv Godot_v4.3-stable_linux.x86_64 /usr/local/bin/godot
          sudo chmod +x /usr/local/bin/godot
          mkdir -p "$HOME/.local/share/godot/export_templates/4.3.stable"
          unzip -q templates.tpz -d tpl
          mv tpl/templates/* "$HOME/.local/share/godot/export_templates/4.3.stable/"
          godot --version

      - name: Configure Android signing
        run: |
          keytool -genkeypair -v \
            -keystore "$HOME/debug.keystore" \
            -storepass android -keypass android \
            -alias androiddebugkey -keyalg RSA \
            -keysize 2048 -validity 10000 \
            -dname "CN=Android Debug,O=Android,C=US" \
            -storetype pkcs12
          mkdir -p "$HOME/.config/godot"
          cat > "$HOME/.config/godot/editor_settings-4.3.tres" <<EOF
          [gd_resource type="EditorSettings" format=3]
          [resource]
          export/android/android_sdk_path = "$ANDROID_HOME"
          export/android/java_sdk_path = "$JAVA_HOME"
          export/android/debug_keystore = "$HOME/debug.keystore"
          export/android/debug_keystore_user = "androiddebugkey"
          export/android/debug_keystore_pass = "android"
          EOF

      - name: Test project
        run: |
          mkdir -p build logs
          godot --headless --path src --import 2>&1 | tee logs/import.log
          godot --headless --path src -s tests/smoke_test.gd 2>&1 | tee logs/test.log
          grep -q "SMOKE: PASS" logs/test.log

      - name: Build Android APK
        run: |
          godot --headless --path src \
            --export-debug "Android" \
            build/deadhorizon-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Dead-Horizon-Android-APK
          path: build/deadhorizon-debug.apk
          if-no-files-found: error

      - name: Upload build logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: Dead-Horizon-Build-Logs
          path: logs/
          if-no-files-found: ignore
